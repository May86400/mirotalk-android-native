<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/webex_night">
    <FrameLayout android:id="@+id/videoGrid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center" android:background="@color/webex_panel">
        <ToggleButton android:id="@+id/micButton" android:layout_width="64dp" android:layout_height="56dp" android:textOn="Mic on" android:textOff="Mic off" />
        <ToggleButton android:id="@+id/cameraButton" android:layout_width="76dp" android:layout_height="56dp" android:layout_marginStart="16dp" android:textOn="Camera on" android:textOff="Camera off" />
        <Button android:id="@+id/peopleButton" android:layout_width="64dp" android:layout_height="56dp" android:layout_marginStart="16dp" android:text="People" android:textAllCaps="false" />
        <Button android:id="@+id/hangupButton" android:layout_width="72dp" android:layout_height="56dp" android:layout_marginStart="16dp" android:text="End" android:textAllCaps="false" android:backgroundTint="@color/webex_red" />
    </LinearLayout>
</LinearLayout>